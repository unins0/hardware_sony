android_app {
    name: "XperiaHaptics",
    certificate: "platform",
    srcs: [
        "src/**/*.kt",
    ],
    required: [
        "privapp-permissions_com.xperia.settings.haptics",
        "config-com.xperia.settings.haptics",
    ],
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "SettingsLib",
    ],
}

prebuilt_etc {
    name: "privapp-permissions_com.xperia.settings.haptics",
    sub_dir: "permissions",
    src: "privapp-permissions_com.xperia.settings.haptics.xml",
    system_ext_specific: true,
    filename_from_src: true,
}

prebuilt_etc {
    name: "config-com.xperia.settings.haptics",
    sub_dir: "sysconfig",
    src: "config-com.xperia.settings.haptics.xml",
    system_ext_specific: true,
    filename_from_src: true,
}
